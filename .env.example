# openplex environment variables
#
# Every value here is OPTIONAL. openplex is local-first and fully usable with no
# env vars at all — these only let you bake Supabase sync defaults into a build so
# sync is preconfigured for every visitor. You can always paste the same values at
# runtime in Settings -> Account & Sync (stored in the browser).
#
# Only VITE_-prefixed vars are exposed to the client by Vite. Copy this file to
# `.env` (or `.env.local`) and fill in what you need.

# Supabase project URL for cross-device sync (e.g. https://xxxx.supabase.co).
# Optional — leave blank to keep sync runtime-configured per browser.
VITE_SUPABASE_URL=

# Supabase anon (public) key, paired with VITE_SUPABASE_URL.
# Optional — safe to ship in the client; row-level security guards the data.
VITE_SUPABASE_ANON_KEY=
